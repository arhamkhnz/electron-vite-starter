{
  "name": "electron-vite-starter",
  "productName": "Electron Vite Starter",
  "description": "A production-ready Electron, React, TypeScript, and Vite foundation.",
  "author": {
    "name": "Arham Khan",
    "email": "43849669+arhamkhnz@users.noreply.github.com"
  },
  "homepage": "https://github.com/arhamkhnz/electron-vite-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "npm run lint:fix; npm run format",
    "preview:renderer": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir --publish never",
    "make": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.11.5",
    "electron-builder": "^26.18.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  }
}
